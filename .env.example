# Configuration d'exemple - Copier dans .env et configurer

# ==================== Base de données MySQL ====================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=uor_university
DB_PORT=3306

# ==================== Sécurité ====================
SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRATION=3600
PASSWORD_MIN_LENGTH=6
FINANCIAL_THRESHOLD=0.00

# ==================== Email (Gmail SMTP) ====================
# Instructions:
# 1. Enable 2FA on https://myaccount.google.com/
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Copy the 16-character password (without spaces)

EMAIL_SERVICE=gmail
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_LOGO_PATH=E:/SECRET FILES/MY_TFC/assets/uor_logo.png

# ==================== Validation Super Admin par e-mail ====================
# URL publique (ou tunnel) du service d'approbation des demandes d'accès
# Exemples:
#  - https://admin.uor.example.com
#  - https://xxxx.ngrok-free.app
ACCESS_APPROVAL_BASE_URL=

# Durée de validité des liens e-mail (heures)
ACCESS_APPROVAL_TOKEN_TTL_HOURS=72

# Secret dédié aux liens d'approbation (laisser vide = fallback SECRET_KEY)
ACCESS_APPROVAL_TOKEN_SECRET=

# Runtime API approbation
ACCESS_APPROVAL_API_HOST=0.0.0.0
ACCESS_APPROVAL_API_PORT=5002
ACCESS_APPROVAL_API_DEBUG=False
ACCESS_APPROVAL_AUTOSTART=True

# ==================== WhatsApp (Twilio) ====================
# Instructions:
# 1. Create account at https://www.twilio.com/try-twilio
# 2. Get SID from https://console.twilio.com/
# 3. Get Auth Token from https://console.twilio.com/ ("Show" button)
# 4. Enable WhatsApp at https://console.twilio.com/develop/sms/try-it-out/whatsapp-learn
# 5. Copy Sandbox Twilio WhatsApp Number (e.g., +14155238886)

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886

# ==================== WhatsApp Templates (Optional) ====================
# For pre-approved branded messages (50% cheaper, requires approval)
# Create at: https://console.twilio.com/develop/sms/content-builder
# Leave empty to use standard messages

WHATSAPP_TEMPLATE_ACCESS_CODE=
WHATSAPP_TEMPLATE_THRESHOLD_ALERT=
WHATSAPP_USE_TEMPLATES=False

# ==================== Arduino ====================
# ==================== Arduino (OBSOLÈTE) ====================
# Plus utilisé dans la nouvelle architecture (ESP32 standard remplace Arduino Uno)
# Conservé pour rétro-compatibilité uniquement
ARDUINO_PORT=COM3
ARDUINO_BAUD_RATE=9600

# ==================== Serveur d'Accès ESP32 ====================
# Adresse et port du serveur Python qui reçoit les requêtes de l'ESP32
ACCESS_SERVER_HOST=0.0.0.0
ESP32_HOST=127.0.0.1
ESP32_PORT=5050
ESP32_SOCKET_TIMEOUT=1.5
ESP32_STATUS_REFRESH_MS=5000

# ==================== Caméra IP (Nouvelle Architecture) ====================
# Mode 1: HTTP snapshot (recommandé — rapide)
#   DroidCam (Android)  : http://192.168.1.x:4747/video
#   IP Webcam (Android) : http://192.168.1.x:8080/shot.jpg
#   ESP32-CAM serveur   : http://192.168.1.x/capture
IP_CAMERA_SNAPSHOT_URL=http://192.168.1.50/capture

# Mode 2: Flux RTSP (robuste — utilisé en fallback si snapshot échoue)
#   Hikvision  : rtsp://admin:pass@192.168.1.x:554/Streaming/Channels/101
#   Dahua      : rtsp://admin:pass@192.168.1.x:554/cam/realmonitor?channel=1
#   Reolink    : rtsp://admin:pass@192.168.1.x:554/h264Preview_01_main
IP_CAMERA_URL=rtsp://admin:password@192.168.1.50:554/stream1

# Identifiants caméra IP (optionnel si pas d'authentification)
IP_CAMERA_USERNAME=admin
IP_CAMERA_PASSWORD=your_camera_password

# Mode 3: Yi IoT via FTP (fallback utile si RTSP/HTTP indisponibles)
# Exemple observé: /tmp/motion.jpg (image récente)
IP_CAMERA_FTP_ENABLED=False
IP_CAMERA_FTP_HOST=192.168.1.50
IP_CAMERA_FTP_PORT=21
IP_CAMERA_FTP_PATH=/tmp/motion.jpg
IP_CAMERA_FTP_USERNAME=root
IP_CAMERA_FTP_PASSWORD=your_camera_password

# Auto-découverte IP caméra (si DHCP change l'adresse après reboot)
# Active la recherche réseau puis vérifie l'identité Yi via /etc/jffs2/yi.conf (dev_id)
CAMERA_DEVICE_ID=A83698047J1HVM230224
IP_CAMERA_AUTO_DISCOVERY_ENABLED=False
IP_CAMERA_DISCOVERY_SUBNET=192.168.1.
IP_CAMERA_DISCOVERY_IP_RANGE=1-254
IP_CAMERA_DISCOVERY_TIMEOUT=0.35
IP_CAMERA_DISCOVERY_MAX_WORKERS=48

# ==================== Reconnaissance Faciale ====================
# Tolérance de comparaison faciale (0.0 = très strict, 1.0 = très permissif)
# Recommandé: 0.45 (strict) à 0.55 (normal)
FACE_RECOGNITION_TOLERANCE=0.50

# ==================== Application ====================
DEBUG=False
LOG_LEVEL=INFO

# ==================== IMPORTANT NOTES ====================
# • NEVER commit this file to Git (it's in .gitignore for security)
# • Keep credentials secret - this file contains sensitive information
# • Variables here override hardcoded defaults in config/settings.py
# • Test connection: python -c "from config.settings import *; print(f'DB: {DB_NAME}')"
