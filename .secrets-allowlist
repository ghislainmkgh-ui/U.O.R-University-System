# Lines are regex patterns. If a line matches, it will be ignored by the secret scanner.
# Placeholders / examples
your_auth_token_here
instance_xxxxx
REDACTED
xxxx\s+xxxx\s+xxxx\s+xxxx
<ton_nouveau_token>
# Example values used in docs
CVFBWQ4YH3EGDJVA4P4ZW4R7

# OAuth docs placeholders (non-sensitive)
votre_client_secret

# Runtime env lookups (variable names only)
^\s*client_secret\s*=\s*os\.getenv\("GOOGLE_OAUTH_CLIENT_SECRET",\s*""\)
^\s*client_secret\s*=\s*os\.getenv\("GITHUB_OAUTH_CLIENT_SECRET",\s*""\)
^\s*client_secret\s*=\s*client_secret\s*,?\s*$
^\s*access_token\s*=\s*token_json\.get\("access_token",\s*""\)
^\s*["']client_secret["']\s*:\s*client_secret\s*,?\s*$

# Notification config references (no hardcoded secrets)
^\s*self\.email_password\s*=\s*EMAIL_PASSWORD\s*$
^\s*self\.whatsapp_token\s*=\s*WHATSAPP_AUTH_TOKEN\s*$
^\s*self\.ultramsg_token\s*=\s*ULTRAMSG_TOKEN\s*$

# API auth/token variable names (non-secrets)
^\s*auth_header\s*=\s*request\.headers\['Authorization'\]\s*$
^\s*token\s*=\s*auth_header\.split\(" "\)\[1\]\s*#\s*Format:\s*"Bearer\s*<token>"\s*$
^\s*def\s+generate_api_token\(university_code,\s*secret_key\):\s*$
^\s*token\s*=\s*generate_api_token\(university_code,\s*app\.config\['SECRET_KEY'\]\)\s*$
